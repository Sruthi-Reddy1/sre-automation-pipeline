# ServiceNow
SNOW_INSTANCE=your-instance.service-now.com
SNOW_USER=svc-sre-automation
SNOW_PASS=your-service-account-password

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Splunk webhook signature secret
# Leave empty for local testing, set in production
SPLUNK_WEBHOOK_SECRET=

# AWS
AWS_REGION=us-east-1

# Set to false for live incident creation
DRY_RUN=true
